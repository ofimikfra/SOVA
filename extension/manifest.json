{
  "manifest_version": 3,
  "name": "SOVA",
  "version": "1.0",
  "description": "Real-time facial expression and gesture description for Google Meet participants.",

  "permissions": [
    "storage",
    "activeTab",
    "tabCapture"
  ],
  "web_accessible_resources": [
  {
    "resources": ["logo.png"],
    "matches": ["https://meet.google.com/*"]
  }
  ],

  "host_permissions": [
    "https://meet.google.com/*",
    "http://127.0.0.1:5000/*"
  ],

  "content_scripts": [
    {
      "matches": ["https://meet.google.com/*"],
      "js": ["content.js"],
      "css": ["styles.css"],
      "run_at": "document_idle"
    }
  ],

  "background": {
    "service_worker": "background.js"
  },

  "action": {
    "default_popup": "index.html",
    "default_title": "SOVA",
    "default_icon": "logo.png"
  }
}